services:
  angie:
    image: $ANGIE_IMAGE
    container_name: angie
    restart: unless-stopped
    network_mode: host
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
    volumes:
      - angie-data:/var/lib/angie
      - $RELEASE_DIR/angie.conf:/etc/angie/angie.conf:ro
      - $RELEASE_DIR/index.html:/tmp/index.html:ro
      - $RELEASE_DIR/www:/var/www:ro
  marzban:
    image: $MARZBAN_IMAGE
    container_name: marzban
    restart: unless-stopped
    env_file: $RELEASE_DIR/marzban/.env
    network_mode: host
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
    volumes:
      - $RELEASE_DIR/marzban/xray_config.json:/code/xray_config.json
      - $RELEASE_DIR/xray-core:/code/xray-core:ro
      - $INSTALL_ROOT/marzban_lib:/var/lib/marzban

volumes:
  angie-data:
    name: angie-data
