services:
  angie:
    image: $ANGIE_IMAGE
    container_name: angie
    restart: unless-stopped
    network_mode: host
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
    volumes:
      - angie-data:/var/lib/angie
      - $RELEASE_DIR/angie.conf:/etc/angie/angie.conf:ro
      - $RELEASE_DIR/index.html:/tmp/index.html:ro
      - $RELEASE_DIR/www:/var/www:ro
  xray:
    image: $XRAY_IMAGE
    container_name: xray
    restart: unless-stopped
    network_mode: host
    user: root
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
    volumes:
      - $RELEASE_DIR/xray:/etc/xray:ro
    entrypoint: ["xray", "run", "-config", "/etc/xray/config.json"]

volumes:
  angie-data:
    name: angie-data
